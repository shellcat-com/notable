<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Phase 1 dev build runs NON-sandboxed so Screen Recording (TCC) permission
	survives ad-hoc-signed rebuilds. Hardening task before any public release:
	flip app-sandbox to <true/> and add:
	    com.apple.security.files.user-selected.read-write  (for the Save panel)
	See CLAUDE.md → "Sandbox" for the full checklist.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
