---
import Layout from '../layouts/Layout.astro';
import AuroraHero from '../components/AuroraHero.tsx';
import { tools, features, shortcuts, guides, faqs, stats } from '../data/site';
---

<Layout>
  <header class="glass-nav">
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="#top" class="flex items-center gap-2 font-semibold tracking-tight">
        <img src="/favicon.svg" alt="" width="28" height="28" class="rounded-lg" />
        Parcel
      </a>
      <nav class="hidden items-center gap-6 text-sm text-white/70 md:flex">
        <a href="#features" class="hover:text-white">Features</a>
        <a href="#privacy" class="hover:text-white">Privacy</a>
        <a href="#guides" class="hover:text-white">Guides</a>
        <a href="https://github.com/bswxyz/notable" class="hover:text-white">GitHub</a>
      </nav>
      <a href="/downloads/Parcel.zip" class="btn-primary text-sm" download>Download</a>
    </div>
  </header>

  <main id="top">
    <section class="relative overflow-hidden pt-28 pb-20">
      <AuroraHero client:load />
      <div class="relative mx-auto max-w-6xl px-6">
        <p class="section-kicker mb-4">Native macOS · MIT · Open source</p>
        <h1 class="max-w-3xl text-5xl font-bold tracking-tight md:text-6xl">
          The Capture tool <span class="bg-gradient-to-r from-violet to-fuchsia bg-clip-text text-transparent">Apple forgot</span> to make.
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-white/70">
          From Parable — annotate, censor, beautify, record, scroll capture, OCR, and upload with a local-first privacy story.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/downloads/Parcel.zip" class="btn-primary" download>Download for macOS</a>
          <a href="#install" class="btn-secondary">Install notes</a>
        </div>
        <dl class="mt-12 grid grid-cols-2 gap-6 sm:grid-cols-4">
          {stats.map((s) => (
            <div>
              <dt class="font-mono text-3xl font-semibold">{s.value}</dt>
              <dd class="mt-1 text-sm text-white/60">{s.label}</dd>
            </div>
          ))}
        </dl>
        <div class="mt-16 rounded-2xl border border-line bg-panel/80 p-2 shadow-2xl shadow-black/40 backdrop-blur">
          <div class="flex items-center gap-2 border-b border-line px-4 py-3">
            <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
            <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
            <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
            <span class="ml-3 font-mono text-xs text-white/50">Parcel — Editor</span>
          </div>
          <div class="grid gap-1 p-4 md:grid-cols-[1fr_280px]">
            <div class="rounded-xl bg-gradient-to-br from-[#1a1f2e] to-[#0f1219] p-8 min-h-[220px] flex items-center justify-center text-white/40 text-sm">
              Capture + annotations preview
            </div>
            <div class="rounded-xl border border-line bg-ink/50 p-4 text-sm text-white/70">
              <p class="font-medium text-white mb-2">Tool strip</p>
              <div class="flex flex-wrap gap-2">
                {tools.slice(0, 8).map((t) => (
                  <span class="rounded-md bg-panel px-2 py-1 text-xs font-mono">{t}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="features" class="border-t border-line py-20">
      <div class="mx-auto max-w-6xl px-6">
        <p class="section-kicker">Everything you need</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">Feature depth without the bloat.</h2>
        <div class="mt-10 grid gap-4 md:grid-cols-3">
          {features.map((f) => (
            <article class={`bento-card ${f.span}`}>
              <h3 class="text-lg font-semibold">{f.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-white/65">{f.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="privacy" class="border-t border-line py-20">
      <div class="mx-auto grid max-w-6xl gap-10 px-6 md:grid-cols-2 md:items-center">
        <div>
          <p class="section-kicker">Private by default</p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight">No cloud dependency. No network AI.</h2>
          <p class="mt-4 text-white/70">
            History, brand kits, Vision inspection, adjustments, and export stay local. Upload is real Supabase Storage — never a pretend button.
          </p>
        </div>
        <figure class="rounded-2xl border border-line bg-panel p-4">
          <img src="/assets/notable-permission.svg" alt="Screen Recording permission guidance" class="w-full rounded-lg" />
          <figcaption class="mt-3 text-xs text-white/50">Grant Screen Recording, then quit and reopen Parcel.</figcaption>
        </figure>
      </div>
    </section>

    <section class="border-t border-line py-20">
      <div class="mx-auto max-w-6xl px-6">
        <p class="section-kicker">Keyboard-first</p>
        <h2 class="mt-3 text-3xl font-bold">Every action has a shortcut.</h2>
        <div class="mt-8 overflow-hidden rounded-2xl border border-line">
          <table class="w-full text-left text-sm">
            <tbody>
              {shortcuts.map((row) => (
                <tr class="border-b border-line last:border-0">
                  <td class="w-48 px-4 py-3 font-mono text-mint">{row.keys}</td>
                  <td class="px-4 py-3 text-white/75">{row.action}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="guides" class="border-t border-line py-20">
      <div class="mx-auto max-w-6xl px-6">
        <p class="section-kicker">Guides</p>
        <h2 class="mt-3 text-3xl font-bold">Common Capture workflows.</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2">
          {guides.map((g) => (
            <article class="bento-card">
              <h3 class="font-semibold">{g.title}</h3>
              <p class="mt-2 text-sm text-white/65">{g.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="install" class="border-t border-line py-20">
      <div class="mx-auto max-w-6xl px-6">
        <p class="section-kicker">Install</p>
        <h2 class="mt-3 text-3xl font-bold">Try the current Mac build.</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          <div class="bento-card">
            <h3 class="font-semibold">Direct download</h3>
            <p class="mt-2 text-sm text-white/65">Unzip, open, grant Screen Recording, quit and reopen.</p>
            <a href="/downloads/Parcel.zip" class="btn-primary mt-4" download>Parcel.zip</a>
          </div>
          <div class="bento-card">
            <h3 class="font-semibold">Homebrew</h3>
            <code class="mt-3 block rounded-lg bg-ink p-3 font-mono text-xs text-mint">brew install --cask parcel</code>
            <p class="mt-2 text-xs text-white/50">Requires the cask in this repo's Casks/ folder or a published tap.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="border-t border-line py-20">
      <div class="mx-auto max-w-3xl px-6">
        <h2 class="text-3xl font-bold">FAQ</h2>
        <div class="mt-8 space-y-4">
          {faqs.map((item) => (
            <details class="bento-card group">
              <summary class="cursor-pointer list-none font-medium marker:content-none">{item.q}</summary>
              <p class="mt-3 text-sm text-white/65">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="border-t border-line py-20">
      <div class="mx-auto max-w-6xl rounded-3xl border border-violet/30 bg-gradient-to-br from-violet/20 to-fuchsia/10 px-8 py-14 text-center">
        <h2 class="text-3xl font-bold">Ready to Capture?</h2>
        <p class="mx-auto mt-3 max-w-xl text-white/70">Free, open source, and built for daily macOS work.</p>
        <a href="/downloads/Parcel.zip" class="btn-primary mt-8" download>Download Parcel</a>
      </div>
    </section>
  </main>

  <footer class="border-t border-line py-10 text-center text-sm text-white/50">
    <p>Parcel by Parable · MIT License</p>
    <p class="mt-2"><a href="https://github.com/bswxyz/notable" class="text-mint hover:underline">GitHub</a></p>
  </footer>
</Layout>
